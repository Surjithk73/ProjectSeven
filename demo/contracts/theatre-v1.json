{
  "openapi": "3.0.3",
  "info": {
    "title": "Grand Cinema theatre provider",
    "version": "1.0.0"
  },
  "paths": {
    "/shows": {
      "get": {
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "shows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "movie": {
                            "type": "string"
                          },
                          "price_paise": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "id",
                          "movie",
                          "price_paise"
                        ]
                      }
                    }
                  },
                  "required": [
                    "shows"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/shows/{show_id}/seats": {
      "get": {
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "seats": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "available": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "available"
                        ]
                      }
                    },
                    "price_paise": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "seats",
                    "price_paise"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "show_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/holds": {
      "post": {
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hold_id": {
                      "type": "string"
                    },
                    "amount_paise": {
                      "type": "integer"
                    },
                    "expires_at": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "hold_id",
                    "amount_paise",
                    "expires_at"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "show_id": {
                    "type": "string"
                  },
                  "seat_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "idempotency_key": {
                    "type": "string"
                  }
                },
                "required": [
                  "show_id",
                  "seat_ids",
                  "idempotency_key"
                ]
              }
            }
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "booking_id": {
                      "type": "string"
                    },
                    "show_id": {
                      "type": "string"
                    },
                    "seat_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "amount_paise": {
                      "type": "integer"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "payment_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "booking_id",
                    "show_id",
                    "seat_ids",
                    "amount_paise",
                    "currency",
                    "status",
                    "payment_id"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hold_id": {
                    "type": "string"
                  },
                  "payment_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "hold_id",
                  "payment_id"
                ]
              }
            }
          }
        }
      }
    }
  }
}
