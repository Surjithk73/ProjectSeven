  "components": {
    "schemas": {
      "AnalyticsRequest": {
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1,
            "title": "Event"
          },
          "user": {
            "type": "string",
            "minLength": 1,
            "title": "User"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event",
          "user",
          "data"
        ],
        "title": "AnalyticsRequest"
      },
      "AnalyticsResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "event": {
            "type": "string",
            "title": "Event"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "status",
          "event",
          "user_id",
          "metadata"
        ],
        "title": "AnalyticsResponse"
      },
      "BillingAddress": {
        "properties": {
          "street": {
            "type": "string",
            "minLength": 1,
            "title": "Street"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "title": "City"
          },
          "country": {
            "type": "string",
            "minLength": 1,
            "title": "Country"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "street",
          "city",
          "country"
        ],
        "title": "BillingAddress"
      },
      "ChargeRequestV3": {
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/CurrencyAmount"
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id"
          },
          "send_email_receipt": {
            "type": "boolean",
            "title": "Send Email Receipt",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount",
          "user_id"
        ],
        "title": "ChargeRequestV3"
      },
      "ChargeResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "charge_id": {
            "type": "string",
            "title": "Charge Id"
          },
          "amount_charged": {
            "type": "integer",
            "title": "Amount Charged"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "charge_id",
          "amount_charged",
          "user_id"
        ],
        "title": "ChargeResponse"
      },
      "CurrencyAmount": {
        "properties": {
          "value": {
            "type": "integer",
            "title": "Value"
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "title": "Currency"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "currency"
        ],
        "title": "CurrencyAmount"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvoiceHistoryResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "invoices": {
            "items": {
              "$ref": "#/components/schemas/InvoiceResponse"
            },
            "type": "array",
            "title": "Invoices"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "invoices"
        ],
        "title": "InvoiceHistoryResponse"
      },
      "InvoiceRequestV2": {
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id"
          },
          "period": {
            "type": "string",
            "minLength": 1,
            "title": "Period"
          },
          "billing_address": {
            "$ref": "#/components/schemas/BillingAddress"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "period",
          "billing_address"
        ],
        "title": "InvoiceRequestV2"
      },
      "InvoiceResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "invoice_id": {
            "type": "string",
            "title": "Invoice Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "period": {
            "type": "string",
            "title": "Period"
          },
          "pdf_url": {
            "type": "string",
            "title": "Pdf Url"
          }
        },
        "type": "object",
        "required": [
          "status",
          "invoice_id",
          "user_id",
          "period",
          "pdf_url"
        ],
        "title": "InvoiceResponse"
      },
      "RefundRequest": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "minLength": 1,
            "title": "Transaction Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transaction_id"
        ],
        "title": "RefundRequest"
      },
      "RefundResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "refund_id": {
            "type": "string",
            "title": "Refund Id"
          },
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "refund_id",
          "transaction_id"
        ],
        "title": "RefundResponse"
      },
      "SendInvoiceRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id"
          },
          "invoice_id": {
            "type": "string",
            "minLength": 1,
            "title": "Invoice Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "invoice_id"
        ],
        "title": "SendInvoiceRequest"
      },
      "SendInvoiceResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "invoice_id": {
            "type": "string",
            "title": "Invoice Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "invoice_id",
          "user_id"
        ],
        "title": "SendInvoiceResponse"
      },
      "StatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "charge_id": {
            "type": "string",
            "title": "Charge Id"
          },
          "payment_status": {
            "type": "string",
            "title": "Payment Status"
          }
        },
        "type": "object",
        "required": [
          "status",
          "charge_id",
          "payment_status"
        ],
        "title": "StatusResponse"
      },
      "SummaryResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "total_spent": {
            "type": "integer",
            "title": "Total Spent"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "total_spent",
          "currency"
        ],
        "title": "SummaryResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WrappedAnalyticsResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AnalyticsResponse"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "WrappedAnalyticsResponse"
      },
      "WrappedSummaryResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SummaryResponse"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "WrappedSummaryResponse"
      }
    }
  }
}
