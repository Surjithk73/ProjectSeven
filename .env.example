# Leave credentials empty for offline tests and reset. Never commit .env.
GEMINI_MODEL=gemini-2.5-flash
POLL_INTERVAL_SECONDS=10
# Compose overrides local service URLs with service DNS names.
API_BASE=http://127.0.0.1:8001
PROVIDER_URL=http://127.0.0.1:8001
BFF_URL=http://127.0.0.1:8003
API_VERSION=v1
# Optional native CLI override. Docker supplies a Linux binary on PATH.
OASDIFF_BIN=
# Optional publication credentials for explicitly requested PR creation.
GITHUB_TOKEN=
GITHUB_REPO=
# Optional allowlisted isolated Phase 2 dashboard jobs. Paths are trusted server configuration.
APISHIELD_INTEGRATIONS={}
APISHIELD_JOBS_DIR=
# Optional override; default is ~/.apishield/credentials/service-account.json
APISHIELD_CREDENTIALS_FILE=
